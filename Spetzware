        foreach ($line in (Get-UnsignedUserProgramAlerts)) {
            if ($line -like 'SUCCESS*') { continue }
            Write-MonitorAlertOnce -Category 'userprog' -Message $line -LogFile $logFile
        }
    }

    $folderScanCounter++
