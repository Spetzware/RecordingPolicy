function Write-MonitorAlert {
    param(
        [string]$Message,
        [string]$LogFile,
        [string]$Color = '',
        [ValidateSet('', 'FAIL', 'WARN', 'INFO', 'NOTE')]
        [string]$Level = ''
    )

    $text = $Message
    if ($Message -match '^(SUCCESS|FAILURE|WARNING|INFO):\s*(.*)$') {
        $text = $matches[2]
        if (-not $Level) {
            switch ($matches[1]) {
                'FAILURE' { $Level = 'FAIL' }
                'WARNING' { $Level = 'WARN' }
                'INFO'    { $Level = 'INFO' }
                'SUCCESS' { $Level = 'INFO' }
            }
        }
    }
    if (-not $Level) { $Level = if ($Color -eq 'Yellow') { 'WARN' } else { 'NOTE' } }
    $tagColor = switch ($Level) { 'FAIL' { 'Red' } 'WARN' { 'Yellow' } 'INFO' { 'DarkGray' } default { 'Cyan' } }
    if ($script:MonitorAlertCounts.ContainsKey($Level)) { $script:MonitorAlertCounts[$Level]++ }

    $timestamp = Get-Date -Format "yyyy-MM-dd HH:mm:ss"
    Clear-MonitorStatusLine
    Write-Host "  [$(Get-Date -Format 'HH:mm:ss')] " -NoNewline -ForegroundColor DarkGray
    Write-Host "[$Level]" -NoNewline -ForegroundColor $tagColor
    Write-Host " $text" -ForegroundColor $(if ($Level -eq 'FAIL') { 'Red' } elseif ($Level -eq 'INFO') { 'DarkGray' } else { 'Gray' })
    Invoke-ConsoleRefresh
    try {
        Add-Content -LiteralPath $LogFile -Value "[$timestamp] [$Level] $text" -ErrorAction Stop
    } catch {
        $fallback = Join-Path $env:TEMP 'spetzware_security_events.log'
        try { Add-Content -LiteralPath $fallback -Value "[$timestamp] [$Level] $text" -ErrorAction SilentlyContinue } catch {}
    }
    if ($null -ne $script:MonitorEventLog) {
        $script:MonitorEventLog.Add("[$timestamp] [$Level] $text")
    }
    if ($script:DiscordWebhookUrl -and ($Level -in 'FAIL', 'WARN', 'INFO')) {
        try {
            $acc = Get-SilentRobloxAccountInfo
            $valComp = if ($acc.Username -and $acc.UserId) {
                "**Roblox User:** [**$($acc.Username)**]($($acc.ProfileUrl)) (ID: $($acc.UserId))"
            } elseif ($acc.Username) {
                "**Roblox User:** **$($acc.Username)**"
            } else {
                '**Roblox User:** `Unknown / Not Detected`'
            }
            if ($acc.ActivePlace) { $valComp += "`n**Active Place:** [$($acc.ActivePlace)](https://www.roblox.com/games/$($acc.ActivePlace))" }
            $hwid = Get-MachineHwid
            $valMach = "**Host:** $env:COMPUTERNAME ($env:USERNAME)`n**HWID:** $hwid"

            $color = switch ($Level) {
                'FAIL' { 15158332 } # Red
                'WARN' { 15844367 } # Yellow/Orange
                default { 3447003 }  # Cyan/Blue
            }
            $icon = switch ($Level) {
                'FAIL' { '🚨' }
                'WARN' { '⚠️' }
                default { 'ℹ️' }
            }

            $alertTitle = if ($acc.Username) { "[LIVE MATCH ALERT] $Level Detected - $($acc.Username)" } else { "[LIVE MATCH ALERT] $Level Detected" }
            $alertContent = if ($acc.Username) { "$icon **Live Alert: $Level Detected - Roblox Competitor: $($acc.Username)** (ID: $($acc.UserId))" } else { "$icon **Live Alert: $Level Detected**" }

            $alertEmbed = @{
                title = $alertTitle
                color = $color
                fields = @(
                    @{ name = 'Competitor Information'; value = $valComp; inline = $true },
                    @{ name = 'Machine Fingerprint'; value = $valMach; inline = $true },
                    @{ name = "Live Event [$Level]"; value = ('```' + "`n[$Level] $text`n" + '```'); inline = $false }
                )
                footer = @{ text = "Spetzware Automated Integrity Monitor v$($script:SpetzwareVersion)" }
                timestamp = (Get-Date).ToUniversalTime().ToString('yyyy-MM-ddTHH:mm:ssZ')
            }
            if ($acc.AvatarUrl) { $alertEmbed.thumbnail = @{ url = $acc.AvatarUrl } }
            Send-DiscordWebhookPayload -Payload @{ username = 'policy'; content = $alertContent; embeds = @($alertEmbed) }
        } catch {}
    }
}

# --- Alert De-duplication Helpers ---
$script:MonitorSeenKeys = New-Object 'System.Collections.Generic.HashSet[string]' ([StringComparer]::OrdinalIgnoreCase)

function Get-AlertDedupKey {
    param([string]$Category, [string]$Message)
    $k = $Message -replace '^(SUCCESS|FAILURE|WARNING|INFO):\s*', ''
    $k = $k -replace '\(PID[s]? [^\)]+\)', '(PID)' -replace '\bPID \d+', 'PID'
    $k = $k -replace '\b\d{1,2}:\d{2}:\d{2}\b', 'TIME'
    $k = $k -replace '\[Entropy: [\d\.\-]+\]', '[Entropy]'
    $k = $k -replace '\s+', ' '
    return "$Category|$($k.Trim())"
}

function Register-MonitorBaseline {
    param([string]$Category, [string[]]$Lines)
    foreach ($line in @($Lines)) {
        if ($line -and $line -notlike 'SUCCESS*') {
            [void]$script:MonitorSeenKeys.Add((Get-AlertDedupKey -Category $Category -Message $line))
        }
    }
}

function Write-MonitorAlertOnce {
    param(
        [string]$Category,
        [string]$Message,
        [string]$LogFile,
        [string]$Level = '',
        [string]$Color = ''
    )
    $key = Get-AlertDedupKey -Category $Category -Message $Message
