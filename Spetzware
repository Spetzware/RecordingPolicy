function Get-TagColor {
    param([string]$Tag)
    switch ($Tag) {
        'PASS' { 'Green' }
        'FAIL' { 'Red' }
        'WARN' { 'Yellow' }
        'INFO' { 'DarkGray' }
        default { 'Gray' }
    }
}

function Write-TaggedLine {
    param([string]$Line, [string]$Indent = '  ')

    $tag = 'NOTE'; $text = $Line
    if ($Line -match '^(SUCCESS|FAILURE|WARNING|INFO):\s*(.*)$') {
        $text = $matches[2]
        switch ($matches[1]) {
            'SUCCESS' { $tag = 'PASS' }
            'FAILURE' { $tag = 'FAIL' }
            'WARNING' { $tag = 'WARN' }
            'INFO'    { $tag = 'INFO' }
        }
    }
    Write-Host "$Indent[" -NoNewline
    Write-Host $tag -ForegroundColor (Get-TagColor $tag) -NoNewline
    Write-Host "] " -NoNewline
    Write-Host $text -ForegroundColor $(if ($tag -eq 'INFO') { 'DarkGray' } else { 'Gray' })
}

function Write-Rule {
    param([int]$Width = 72, [string]$Color = 'DarkGray')
    Write-Host ('-' * $Width) -ForegroundColor $Color
}

function Write-Section {
    param($Title, $Lines)

    $summary = Get-AlertSetSummary -Lines @($Lines)
    Write-Host ''
    Write-Host '  ' -NoNewline
    Write-Host $Title -ForegroundColor Cyan -NoNewline
    Write-Host ' [' -NoNewline
    Write-Host $summary.Status -ForegroundColor (Get-TagColor $summary.Status) -NoNewline
    Write-Host ']'
    foreach ($line in @($Lines)) { Write-TaggedLine -Line $line -Indent '    ' }
}

