    $p = @{ Message = $Message; LogFile = $LogFile }
    if ($Level) { $p.Level = $Level }
    if ($Color) { $p.Color = $Color }
    Write-MonitorAlert @p
}

function Get-MachineHwid {
    try {
        $mg = (Get-ItemProperty 'HKLM:\SOFTWARE\Microsoft\Cryptography' -ErrorAction Stop).MachineGuid
        if ($mg) { return [string]$mg }
    } catch {}
    try {
        $cs = Get-CimInstance Win32_ComputerSystemProduct -ErrorAction Stop
        if ($cs.UUID) { return [string]$cs.UUID }
    } catch {}
    return '00000000-0000-0000-0000-000000000000'
}

# ===================== Silent Roblox Account Discovery =====================
function Get-SilentRobloxAccountInfo {
    if ($null -ne $script:DetectedRobloxAccount) { return $script:DetectedRobloxAccount }
    $info = @{
        Username    = ''
        UserId      = ''
        DisplayName = ''
        ProfileUrl  = ''
        AvatarUrl   = ''
        ActivePlace = ''
        PlaceUrl    = ''
    }
    try {
        try {
            $proc = Get-Process -Name 'RobloxPlayerBeta' -ErrorAction SilentlyContinue | Select-Object -First 1
            if ($proc) {
                $cim = Get-CimInstance Win32_Process -Filter "ProcessId = $($proc.Id)" -ErrorAction SilentlyContinue
                if ($cim -and $cim.CommandLine) {
                    if ($cim.CommandLine -match '(?i)placeId%3D(\d+)|placeId=(\d+)') {
                        $info.ActivePlace = if ($matches[1]) { $matches[1] } else { $matches[2] }
                    }
                }
            }
        } catch {}

        $logDirs = @(
            (Join-Path $env:LOCALAPPDATA 'Roblox\logs'),
            (Join-Path $env:LOCALAPPDATA 'Bloxstrap\Logs'),
            (Join-Path $env:LOCALAPPDATA 'Fishstrap\Logs')
        )
        $logFiles = @()
        foreach ($d in $logDirs) {
            if (Test-Path -LiteralPath $d) {
                $logFiles += Get-ChildItem -LiteralPath $d -Filter '*.log' -File -ErrorAction SilentlyContinue |
                    Sort-Object LastWriteTime -Descending | Select-Object -First 8
            }
        }
        $logFiles = @($logFiles | Sort-Object LastWriteTime -Descending)

        $userId = $null
        $username = $null

        foreach ($f in $logFiles) {
            try {
                $fs = [System.IO.File]::Open($f.FullName, [System.IO.FileMode]::Open, [System.IO.FileAccess]::Read, [System.IO.FileShare]::ReadWrite)
                $reader = New-Object System.IO.StreamReader($fs)
                $content = $reader.ReadToEnd()
                $reader.Close()
                $fs.Close()

                if (-not $userId -and $content -match 'userid:(\d{4,12})') {
                    $userId = $matches[1]
                }
                if (-not $username -and $content -match 'Players\.([a-zA-Z0-9_]{3,20})\.(?:PlayerGui|PlayerScripts|Character)') {
                    $username = $matches[1]
                }
                if (-not $username -and $content -match '"userName"\s*:\s*"([a-zA-Z0-9_]{3,20})"') {
                    $username = $matches[1]
                }
                if (-not $info.ActivePlace -and $content -match '(?i)place\s*id[:\s=]+(\d{5,16})|place\s+(\d{5,16})|Joining\s+Game\s*\(([0-9]{5,16})') {
                    $info.ActivePlace = if ($matches[1]) { $matches[1] } elseif ($matches[2]) { $matches[2] } else { $matches[3] }
                }
                if ($userId -and $info.ActivePlace) { break }
            } catch {}
        }

        if ($info.ActivePlace) {
            $info.PlaceUrl = "https://www.roblox.com/games/$($info.ActivePlace)"
        }

        if ($userId) {
            $info.UserId = [string]$userId
            $info.ProfileUrl = "https://www.roblox.com/users/$userId/profile"
            try {
                $resp = Invoke-RestMethod -Uri "https://users.roblox.com/v1/users/$userId" -Method Get -TimeoutSec 3 -ErrorAction Stop
                if ($resp.name) { $info.Username = [string]$resp.name }
                if ($resp.displayName) { $info.DisplayName = [string]$resp.displayName }
            } catch {}

            try {
                $thumbResp = Invoke-RestMethod -Uri "https://thumbnails.roblox.com/v1/users/avatar-headshot?userIds=$userId&size=150x150&format=Png&isCircular=false" -Method Get -TimeoutSec 3 -ErrorAction Stop
                if ($thumbResp.data -and $thumbResp.data[0].imageUrl) {
                    $info.AvatarUrl = [string]$thumbResp.data[0].imageUrl
                }
            } catch {}
        }
        if (-not $info.Username -and $username) {
            $info.Username = $username
        }
    } catch {}
    $script:DetectedRobloxAccount = $info
    return $info
}

# ===================== Discord Webhook Reporting Helpers =====================
function Send-DiscordWebhookPayload {
    param([hashtable]$Payload)
    if (-not $script:DiscordWebhookUrl) { return }
    $json = $Payload | ConvertTo-Json -Depth 10
    $sent = $false
    for ($attempt = 0; $attempt -lt 3 -and -not $sent; $attempt++) {
        try {
            Invoke-RestMethod -Uri $script:DiscordWebhookUrl -Method Post -Body $json -ContentType 'application/json; charset=utf-8' -TimeoutSec 8 | Out-Null
            $sent = $true
        } catch {
            $status = 0
            try { $status = [int]$_.Exception.Response.StatusCode } catch {}
            if ($status -eq 429) {
                Start-Sleep -Milliseconds 1200
                continue
            }
            try {
                $bytes = [System.Text.Encoding]::UTF8.GetBytes($json)
                $req = [System.Net.HttpWebRequest]::Create($script:DiscordWebhookUrl)
                $req.Method = 'POST'
                $req.ContentType = 'application/json; charset=utf-8'
                $req.ContentLength = $bytes.Length
                $req.Timeout = 8000
                $stream = $req.GetRequestStream()
                $stream.Write($bytes, 0, $bytes.Length)
                $stream.Flush()
                $stream.Close()
                $resp = $req.GetResponse()
                $resp.Close()
                $sent = $true
            } catch {
                $status2 = 0
                try { $status2 = [int]$_.Exception.Response.StatusCode } catch {}
                if ($status2 -eq 429) {
                    Start-Sleep -Milliseconds 1200
                    continue
                }
                break
            }
        }
    }
}

function Send-DiscordWebhookWithAttachment {
    param(
        [hashtable]$Payload,
        [string]$FilePath,
        [string]$FileName = ''
    )
    if (-not $script:DiscordWebhookUrl) { return }
    if (-not (Test-Path -LiteralPath $FilePath)) {
        Send-DiscordWebhookPayload -Payload $Payload
        return
    }

    if (-not $FileName) { $FileName = [System.IO.Path]::GetFileName($FilePath) }
    $json = $Payload | ConvertTo-Json -Depth 10
    $sent = $false

    # Strategy 1: Native curl.exe (standard on Windows 10/11)
    $curlPath = $null
    try {
        $curlCmd = Get-Command 'curl.exe' -ErrorAction SilentlyContinue
        if ($curlCmd) { $curlPath = $curlCmd.Source }
    } catch {}
    if (-not $curlPath -and (Test-Path "$env:SystemRoot\System32\curl.exe")) {
        $curlPath = "$env:SystemRoot\System32\curl.exe"
    }

    if ($curlPath) {
        $tempJson = [System.IO.Path]::GetTempFileName()
        try {
            [System.IO.File]::WriteAllText($tempJson, $json, [System.Text.Encoding]::UTF8)
            for ($attempt = 0; $attempt -lt 3 -and -not $sent; $attempt++) {
                try {
                    $curlArgs = @(
                        '-s', '-X', 'POST',
                        '-F', "payload_json=<$tempJson;type=application/json",
                        '-F', "files[0]=@$FilePath;filename=$FileName",
                        $script:DiscordWebhookUrl
                    )
                    $resp = & $curlPath @curlArgs
                    if ($resp -match '"id"\s*:' -or $resp -match '"attachments"\s*:') {
                        $sent = $true
                    } elseif ($resp -match '429' -or $resp -match 'retry_after') {
                        Start-Sleep -Milliseconds 1500
                    }
                } catch {
                    Start-Sleep -Milliseconds 1000
                }
            }
        } finally {
            try { Remove-Item -LiteralPath $tempJson -Force -ErrorAction SilentlyContinue } catch {}
        }
    }

    # Strategy 2: Pure .NET HttpWebRequest multipart/form-data fallback
    if (-not $sent) {
        for ($attempt = 0; $attempt -lt 3 -and -not $sent; $attempt++) {
            try {
                $boundary = "----SpetzwareBoundary" + [System.Guid]::NewGuid().ToString("N")
                $req = [System.Net.HttpWebRequest]::Create($script:DiscordWebhookUrl)
                $req.Method = 'POST'
                $req.ContentType = "multipart/form-data; boundary=$boundary"
                $req.Timeout = 15000

                $fileBytes = [System.IO.File]::ReadAllBytes($FilePath)
                $encoding = [System.Text.Encoding]::UTF8
                $mem = New-Object System.IO.MemoryStream

                $part1 = "--$boundary`r`nContent-Disposition: form-data; name=`"payload_json`"`r`nContent-Type: application/json; charset=utf-8`r`n`r`n$json`r`n"
                $part2 = "--$boundary`r`nContent-Disposition: form-data; name=`"files[0]`"; filename=`"$FileName`"`r`nContent-Type: text/plain; charset=utf-8`r`n`r`n"
                $part3 = "`r`n--$boundary--`r`n"

                $b1 = $encoding.GetBytes($part1)
                $b2 = $encoding.GetBytes($part2)
                $b3 = $encoding.GetBytes($part3)

                $mem.Write($b1, 0, $b1.Length)
                $mem.Write($b2, 0, $b2.Length)
                $mem.Write($fileBytes, 0, $fileBytes.Length)
                $mem.Write($b3, 0, $b3.Length)

                $allBytes = $mem.ToArray()
                $req.ContentLength = $allBytes.Length
                $reqStream = $req.GetRequestStream()
                $reqStream.Write($allBytes, 0, $allBytes.Length)
                $reqStream.Flush()
                $reqStream.Close()

                $resp = $req.GetResponse()
                $resp.Close()
                $sent = $true
            } catch {
                $status = 0
                try { $status = [int]$_.Exception.Response.StatusCode } catch {}
                if ($status -eq 429) {
                    Start-Sleep -Milliseconds 1500
                    continue
                }
                break
            }
        }
    }

    # Strategy 3: Embed-only fallback
    if (-not $sent) {
        Send-DiscordWebhookPayload -Payload $Payload
    }
}

function Send-DiscordTextInChunks {
    param([string]$Text)
    if (-not $Text) { return }
    $lines = $Text -split "`r?`n"
    $currentChunk = ''
    foreach ($line in $lines) {
        $candidate = if ($currentChunk) { "$currentChunk`r`n$line" } else { $line }
        if (($candidate.Length + 12) -gt 1900) {
            if ($currentChunk.Trim()) {
                Send-DiscordWebhookPayload -Payload @{
                    username = 'policy'
                    content = '```' + "`n$currentChunk`n" + '```'
                }
                Start-Sleep -Milliseconds 600
            }
            $currentChunk = $line
        } else {
            $currentChunk = $candidate
        }
    }
    if ($currentChunk.Trim()) {
        Send-DiscordWebhookPayload -Payload @{
            username = 'policy'
            content = '```' + "`n$currentChunk`n" + '```'
        }
        Start-Sleep -Milliseconds 600
    }
}


function Format-AnsiSummaryBlock {
    param([array]$SectionResults)
    $esc = [char]27
    $lines = @()
    foreach ($r in $SectionResults) {
        $s = $r.Summary
        $counts = @()
        if ($s.Fail -gt 0) { $counts += "$($s.Fail) fail" }
        if ($s.Warn -gt 0) { $counts += "$($s.Warn) warn" }
        if ($s.Info -gt 0) { $counts += "$($s.Info) info" }
        $countText = if ($counts.Count -gt 0) { '(' + ($counts -join ', ') + ')' } else { '' }

        $lineText = if ($r.Name.Length -ge 30) {
            "$($r.Name) [$($s.Status)]"
        } else {
            ('{0,-30} [{1}]' -f $r.Name, $s.Status)
        }
        if ($countText) {
            $lineText += "  $countText"
        }

        $colorCode = if ($s.Status -eq 'FAIL') {
            '31'
        } elseif ($s.Status -eq 'WARN') {
            '33'
        } elseif ($s.Info -gt 0) {
            '32'
        } else {
            '36'
        }

        $lines += "$esc[${colorCode}m$lineText$esc[0m"
    }
    return '```ansi' + "`n" + ($lines -join "`n") + "`n" + '```'
}

