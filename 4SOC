    if (-not ($alerts | Where-Object { $_ -like 'FAILURE*' -or $_ -like 'WARNING*' })) {
        $alerts = @('SUCCESS: FastFlag configuration verified (No suspicious physics/hitbox flags)') + $alerts
    }

