public static string[] FindRobloxMemoryReaders(int[] targetPids) {
    List<string> readers = new List<string>();
    if (targetPids == null || targetPids.Length == 0) { return readers.ToArray(); }
    HashSet<int> targets = new HashSet<int>(targetPids);

    int length = 0x40000;
    IntPtr buffer = Marshal.AllocHGlobal(length);
    try {
        int needed = 0;
        int status = 0;
        for (int tries = 0; tries < 16; tries++) {
            status = NtQuerySystemInformation(SystemExtendedHandleInformation, buffer, length, out needed);
            if (status == unchecked((int)0xC0000004)) {
                Marshal.FreeHGlobal(buffer);
                length = (needed > length ? needed : length * 2) + 0x10000;
                buffer = Marshal.AllocHGlobal(length);
                continue;
            }
            break;
        }
        if (status != 0) { return null; }

        int ptr = IntPtr.Size;
        long handleCount = Marshal.ReadIntPtr(buffer).ToInt64();
        int headerSize = ptr * 2;
        int entrySize = ptr * 3 + 16;

        IntPtr self = GetCurrentProcess();
        Dictionary<int, IntPtr> opened = new Dictionary<int, IntPtr>();
        HashSet<string> done = new HashSet<string>();

        for (long i = 0; i < handleCount; i++) {
            int offset = (int)(headerSize + i * entrySize);
            int ownerPid = (int)Marshal.ReadIntPtr(buffer, offset + ptr).ToInt64();
            if (ownerPid <= 4) { continue; }
            if (targets.Contains(ownerPid)) { continue; }
            uint access = (uint)Marshal.ReadInt32(buffer, offset + ptr * 3);
            if ((access & (PROCESS_VM_READ | PROCESS_VM_WRITE | PROCESS_VM_OPERATION)) == 0 && access != 0x1F0FFF && access != 0x1FFFFF) { continue; }
            IntPtr handleValue = Marshal.ReadIntPtr(buffer, offset + ptr * 2);

            IntPtr owner;
            if (!opened.TryGetValue(ownerPid, out owner)) {
                owner = OpenProcess(PROCESS_DUP_HANDLE, false, ownerPid);
                opened[ownerPid] = owner;
            }
            if (owner == IntPtr.Zero) { continue; }

            IntPtr dup;
            if (!DuplicateHandle(owner, handleValue, self, out dup, 0, false, DUPLICATE_SAME_ACCESS)) { continue; }
            try {
                int objPid = GetProcessId(dup);
                if (objPid != 0 && targets.Contains(objPid)) {
                    string key = ownerPid.ToString() + ":" + objPid.ToString();
                    if (done.Add(key)) {
                        List<string> perms = new List<string>();
                        if ((access & PROCESS_VM_READ) != 0) perms.Add("VM_READ");
                        if ((access & PROCESS_VM_WRITE) != 0) perms.Add("VM_WRITE");
                        if ((access & PROCESS_VM_OPERATION) != 0) perms.Add("VM_OPERATION");
                        if (perms.Count == 0) perms.Add("0x" + access.ToString("X"));
                        readers.Add(ownerPid.ToString() + "|" + string.Join("+", perms.ToArray()) + "|" + objPid.ToString());
                    }
                }
            } catch { } finally {
                CloseHandle(dup);
            }
        }

        foreach (KeyValuePair<int, IntPtr> kv in opened) {
            if (kv.Value != IntPtr.Zero) { CloseHandle(kv.Value); }
        }
    } catch {
        return null;
    } finally {
        Marshal.FreeHGlobal(buffer);
    }
    return readers.ToArray();
}

private static IntPtr _resolvedPresentAddr = IntPtr.Zero;

public static IntPtr GetDxgiPresentAddress() {
    if (_resolvedPresentAddr != IntPtr.Zero) return _resolvedPresentAddr;
    try {
        DXGI_SWAP_CHAIN_DESC scd = new DXGI_SWAP_CHAIN_DESC();
        scd.BufferCount = 1;
        scd.BufferDesc.Format = 28;
        scd.BufferDesc.Width = 100;
        scd.BufferDesc.Height = 100;
        scd.BufferUsage = 0x20;
        scd.OutputWindow = GetDesktopWindow();
        scd.SampleDesc.Count = 1;
        scd.Windowed = true;

        IntPtr pSwapChain, pDevice, pContext;
        int featureLevel;
        int hr = D3D11CreateDeviceAndSwapChain(IntPtr.Zero, 1, IntPtr.Zero, 0, null, 0, 7, ref scd, out pSwapChain, out pDevice, out featureLevel, out pContext);
        if (hr != 0) {
            hr = D3D11CreateDeviceAndSwapChain(IntPtr.Zero, 2, IntPtr.Zero, 0, null, 0, 7, ref scd, out pSwapChain, out pDevice, out featureLevel, out pContext);
        }
        if (hr == 0 && pSwapChain != IntPtr.Zero) {
            IntPtr vtable = Marshal.ReadIntPtr(pSwapChain);
            _resolvedPresentAddr = Marshal.ReadIntPtr(vtable, 8 * IntPtr.Size);
            Marshal.Release(pSwapChain);
            if (pDevice != IntPtr.Zero) Marshal.Release(pDevice);
            if (pContext != IntPtr.Zero) Marshal.Release(pContext);
        }
    } catch { }
    return _resolvedPresentAddr;
}

public static string[] FindUnbackedExecutablePages(int pid) {
    List<string> alerts = new List<string>();
    IntPtr hProc = OpenProcess(PROCESS_QUERY_INFORMATION | PROCESS_VM_READ, false, pid);
    if (hProc == IntPtr.Zero) return alerts.ToArray();

    List<Tuple<ulong, ulong>> modules = new List<Tuple<ulong, ulong>>();
    try {
        System.Diagnostics.Process p = System.Diagnostics.Process.GetProcessById(pid);
        foreach (System.Diagnostics.ProcessModule mod in p.Modules) {
            ulong start = (ulong)mod.BaseAddress.ToInt64();
            ulong end = start + (ulong)mod.ModuleMemorySize;
            modules.Add(new Tuple<ulong, ulong>(start, end));
        }
    } catch {}

    string[] cheatKeywords = new string[] {
        "getgenv", "getrenv", "firesignal", "hookmetamethod", "hookfunction",
        "newcclosure", "getrawmetatable", "setreadonly", "cloneref",
        "make_writeable", "drawing.new", "is_fluxus_closure", "solara",
        "wave", "celery", "swift", "incognito"
    };

    try {
        ulong address = 0;
        MEMORY_BASIC_INFORMATION64 mbi;
        uint structSize = (uint)Marshal.SizeOf(typeof(MEMORY_BASIC_INFORMATION64));
        StringBuilder mappedName = new StringBuilder(512);

        while (VirtualQueryEx(hProc, (IntPtr)address, out mbi, structSize) != 0) {
            if (mbi.State == MEM_COMMIT) {
                bool isCurrentExecutable = (mbi.Protect & (PAGE_EXECUTE | PAGE_EXECUTE_READ | PAGE_EXECUTE_READWRITE | PAGE_EXECUTE_WRITECOPY)) != 0;
                bool isAllocatedExecutable = (mbi.AllocationProtect & (PAGE_EXECUTE | PAGE_EXECUTE_READ | PAGE_EXECUTE_READWRITE | PAGE_EXECUTE_WRITECOPY)) != 0;
                if (isCurrentExecutable || isAllocatedExecutable) {
                    bool insideModule = false;
                    foreach (var m in modules) {
                        if (mbi.BaseAddress >= m.Item1 && mbi.BaseAddress < m.Item2) {
                            insideModule = true;
                            break;
                        }
                    }

                    if (!insideModule) {
                        bool isImage = (mbi.Type == MEM_IMAGE);
                        mappedName.Clear();
                        uint mappedLen = 0;
                        if (!isImage) {
                            mappedLen = GetMappedFileName(hProc, (IntPtr)mbi.BaseAddress, mappedName, (uint)mappedName.Capacity);
                        }

                        if (!isImage && mappedLen == 0) {
                            int readLen = (mbi.RegionSize > 8192) ? 8192 : (int)mbi.RegionSize;
                            byte[] buf = new byte[readLen];
                            IntPtr bytesRead;
                            bool hasMz = false;
                            string matchedSig = null;

                            if (ReadProcessMemory(hProc, (IntPtr)mbi.BaseAddress, buf, readLen, out bytesRead) && bytesRead.ToInt64() >= 2) {
                                if (buf[0] == 'M' && buf[1] == 'Z') {
                                    hasMz = true;
                                }
                                string text = Encoding.ASCII.GetString(buf).ToLowerInvariant();
                                foreach (string kw in cheatKeywords) {
                                    if (text.Contains(kw)) {
                                        matchedSig = kw;
                                        break;
                                    }
                                }
                            }

                            string hitType = null;
                            if (hasMz) {
                                hitType = "MZ_PE";
                            } else if (matchedSig != null) {
                                hitType = "SIG_" + matchedSig;
                            } else if ((mbi.Protect & PAGE_EXECUTE_READWRITE) != 0) {
                                hitType = "RWX";
                            } else if (!isCurrentExecutable && isAllocatedExecutable && mbi.RegionSize >= 65536) {
                                hitType = "HIDDEN_EXEC";
                            }

                            if (hitType != null) {
                                ulong sizeKb = mbi.RegionSize / 1024;
                                alerts.Add(string.Format("{0}|0x{1:X}|{2}KB|0x{3:X}|0x{4:X}", hitType, mbi.BaseAddress, sizeKb, mbi.Protect, mbi.AllocationProtect));
                            }
                        }
                    }
                }
            }
            ulong nextAddress = mbi.BaseAddress + mbi.RegionSize;
            if (nextAddress <= address) break;
            address = nextAddress;
        }
    } finally {
        CloseHandle(hProc);
    }
    return alerts.ToArray();
}

public static string[] FindUnbackedThreads(int pid) {
    List<string> alerts = new List<string>();
    System.Diagnostics.Process p;
    try { p = System.Diagnostics.Process.GetProcessById(pid); } catch { return alerts.ToArray(); }

    IntPtr hProc = OpenProcess(PROCESS_QUERY_INFORMATION, false, pid);
    if (hProc == IntPtr.Zero) return alerts.ToArray();

    List<Tuple<long, long, string>> modules = new List<Tuple<long, long, string>>();
    try {
        foreach (System.Diagnostics.ProcessModule m in p.Modules) {
            long baseAddr = m.BaseAddress.ToInt64();
            long endAddr = baseAddr + m.ModuleMemorySize;
            modules.Add(new Tuple<long, long, string>(baseAddr, endAddr, m.ModuleName));
        }
    } catch { }

    try {
        MEMORY_BASIC_INFORMATION64 mbi;
        uint structSize = (uint)Marshal.SizeOf(typeof(MEMORY_BASIC_INFORMATION64));

        foreach (System.Diagnostics.ProcessThread t in p.Threads) {
            IntPtr hThread = OpenThread(THREAD_QUERY_INFORMATION, false, t.Id);
            if (hThread == IntPtr.Zero) continue;
            try {
                IntPtr startAddr;
                int retLen;
                int status = NtQueryInformationThread(hThread, ThreadQuerySetWin32StartAddress, out startAddr, IntPtr.Size, out retLen);
                if (status == 0) {
                    long addr = startAddr.ToInt64();
                    bool insideModule = false;
                    foreach (var m in modules) {
                        if (addr >= m.Item1 && addr < m.Item2) {
                            insideModule = true;
                            break;
                        }
                    }
                    if (!insideModule) {
                        string prot = "UNKNOWN";
                        if (VirtualQueryEx(hProc, startAddr, out mbi, structSize) != 0) {
                            prot = "0x" + mbi.Protect.ToString("X");
                        }
                        alerts.Add(string.Format("UNBACKED_THREAD|{0}|0x{1:X}|{2}", t.Id, addr, prot));
                    }
                }
            } finally {
                CloseHandle(hThread);
            }
        }
    } finally {
        CloseHandle(hProc);
    }
    return alerts.ToArray();
}

