    $searchRoots = @(
        (Join-Path $env:LOCALAPPDATA 'Roblox'),
        (Join-Path $env:LOCALAPPDATA 'Bloxstrap'),
        (Join-Path $env:LOCALAPPDATA 'Fishstrap')
    )

    $candidateFiles = @()
    foreach ($root in $searchRoots) {
        if (Test-Path -LiteralPath $root) {
            $found = Get-ChildItem -LiteralPath $root -Filter 'ClientAppSettings.json' -Recurse -File -ErrorAction SilentlyContinue
            if ($found) { $candidateFiles += $found }
        }
    }

    if ($candidateFiles.Count -eq 0) {
        return @('SUCCESS: No custom ClientAppSettings.json / FastFlag overrides found')
    }

    $suspiciousFlagPatterns = '(?i)HitTest|Hitbox|NoClip|Desync|Wallhack|DebugDisable.*Physics|TaskScheduler.*TargetFps|DebugDisplay'

    foreach ($file in $candidateFiles) {
        try {
            $rawContent = [System.IO.File]::ReadAllText($file.FullName)
            $json = $rawContent | ConvertFrom-Json -ErrorAction Stop

            $propNames = @($json.PSObject.Properties.Name)
            $alerts += "INFO: FastFlags present ($($propNames.Count) flags) -> $($file.FullName)"

            foreach ($prop in $json.PSObject.Properties) {
