                                    $alerts += "FAILURE: Injected unbacked executable code / manual-mapped cheat in $($proc.Name) (PID $($proc.Id)) [$hit] -> Streamproof cheat injection"
                                }
                            }
                        }
                    } catch {}
                }
            }

            # 2. Module digital signature and cheat keyword audit
            try {
                foreach ($mod in $proc.Modules) {
                    $path = [string]$mod.FileName
                    if ([string]::IsNullOrWhiteSpace($path)) { continue }
                    if ($path -like "$env:SystemRoot\System32\*" -or $path -like "$env:SystemRoot\SysWOW64\*" -or $path -like "$env:SystemRoot\WinSxS\*") { continue }
                    if (-not $seenPaths.Add($path)) { continue }

                    $kw = Get-MatchedCheatKeyword -Text $path
                    if ($kw) {
                        $alerts += "FAILURE: Cheat-associated module [$kw] loaded in $($proc.Name) (PID $($proc.Id)) -> $path"
                    }

                    # Whitelist known legitimate unsigned vendor components in official program folders
                    $leaf = (Split-Path -Leaf $path).ToLower()
                    if ($proc.Name -eq 'steam' -and $path -like "*\Steam\*" -and $leaf -eq 'libpyrowave-shared-0.dll') {
                        continue
                    }

                    if ($script:ModuleSigCache.ContainsKey($path)) {
                        $sigInfo = $script:ModuleSigCache[$path]
                    } else {
                        $sig = Microsoft.PowerShell.Security\Get-AuthenticodeSignature -LiteralPath $path -ErrorAction SilentlyContinue
                        $sigStatus = if ($sig) { $sig.Status.ToString() } else { 'Unknown' }
                        $signer = ''
                        if ($sig -and $sig.SignerCertificate -and $sig.SignerCertificate.Subject -match 'CN=([^,]+)') { $signer = $matches[1] }
                        $sigInfo = @{ Status = $sigStatus; Signer = $signer }
                        $script:ModuleSigCache[$path] = $sigInfo
                    }

                    if ($sigInfo.Status -ne 'Valid') {
                        $entropy = Get-FileEntropy -FilePath $path
                        $alerts += "FAILURE: Unsigned/tampered module loaded in $($proc.Name) (PID $($proc.Id)) [Entropy: $entropy] -> $path [$($sigInfo.Status)]"
                    } elseif (Test-UserLandProcessPath -ExecutablePath $path) {
                        $alerts += "WARNING: Userland module loaded in $($proc.Name) (PID $($proc.Id)) ($($sigInfo.Signer)) -> $path"
                    }
                }
            } catch {
                $alerts += "WARNING: Could not inspect modules for $($proc.Name) (PID $($proc.Id))"
            }
        }
    }

    if ($alerts.Count -eq 0) { $alerts += 'SUCCESS: Capture, streaming & overlay applications integrity verified' }
    return @($alerts | Select-Object -Unique)
}

function Get-TransparentOverlayAlerts {
    $alerts = @()
    if (-not (Initialize-SocPolicyIntegrityApi)) { return @('WARNING: Overlay scan API unavailable') }

    $hits = [SocPolicy.IntegrityScan]::FindTopmostOverlays()
    if ($null -eq $hits) { return @('WARNING: Failed to enumerate topmost overlays') }

    $trustedNames = @(
        'dwm', 'explorer', 'taskmgr', 'applicationframehost', 'systemsettings', 'textinputhost',
        'robloxplayerbeta', 'razerappengine', 'rzsynapse', 'rzcortex', 'rzsdkserver', 'razer central',
        'rzdeviceengine', 'rzenginemon', 'nvcontainer', 'nvidia share', 'discord', 'steam',
        'steamwebhelper', 'gameoverlayui', 'obs64', 'obs32', 'gamebar', 'xboxgamebar', 'ctfmon',
        'startmenuexperiencehost', 'shellexperiencehost', 'searchhost', 'snippingtool', 'screenclippinghost',
        'lghub', 'lghub_agent', 'icue', 'steelseriesgg', 'rtss', 'rtsshsv', 'msiafterburner'
    )

    $trustedTitleRegex = '(?i)^(?:RzMonitorForegroundWindow|MSCTFIME UI|Default IME|NVIDIA GeForce Experience|Steam Overlay|Discord Overlay)$'

    foreach ($hit in $hits) {
        $parts = $hit -split '\|', 3
        $pidVal = 0
        [void][int]::TryParse($parts[0], [ref]$pidVal)
        if ($pidVal -le 0 -or $pidVal -eq $PID) { continue }

        $rawTitle = if ($parts.Count -ge 3) { $parts[2] } else { '' }
        $title = if ($rawTitle) { " '$rawTitle'" } else { '' }
        $style = $parts[1]

        # Ignore known legitimate utility window titles
        if ($rawTitle -match $trustedTitleRegex) { continue }

        $pInfo = Resolve-ProcessIdentity -TargetPid $pidVal
        $nameLower = ($pInfo.Name -replace '\.exe$', '').ToLower()
        if ($trustedNames -contains $nameLower) { continue }

        # Check if process is signed by legitimate vendor root
        if ($pInfo.Path -and (Test-SignedByShippedRoot -Path $pInfo.Path)) {
            continue
        }

        if ($pInfo.Path -and -not (Test-TrustedProcessPath -ExecutablePath $pInfo.Path)) {
            $alerts += "FAILURE: Transparent click-through overlay window$title from untrusted path (PID $pidVal, ExStyle 0x$style) -> $($pInfo.Path)"
        } else {
            $alerts += "WARNING: Transparent click-through overlay window$title detected (PID $pidVal, ExStyle 0x$style)"
        }
    }

    if ($alerts.Count -eq 0) { $alerts += 'SUCCESS: No suspicious transparent overlay windows found' }
    return @($alerts | Select-Object -Unique)
}

function Get-TaskManagerIntegrityAlerts {
