function Send-DiscordWebhookPayload {
    param([hashtable]$Payload)
    if ([string]::IsNullOrWhiteSpace($script:DiscordWebhookUrl)) { return }
    try {
        $json = $Payload | ConvertTo-Json -Depth 10
        $utf8Bytes = [System.Text.Encoding]::UTF8.GetBytes($json)

        [Net.ServicePointManager]::SecurityProtocol = [Net.SecurityProtocolType]::Tls12

        $prevCallback = [Net.ServicePointManager]::ServerCertificateValidationCallback
        [Net.ServicePointManager]::ServerCertificateValidationCallback = {
            param($sender, $certificate, $chain, $sslPolicyErrors)
            if ($null -eq $certificate) { return $false }
            try {
                $cert2 = New-Object System.Security.Cryptography.X509Certificates.X509Certificate2 $certificate
                $issuer = [string]$cert2.Issuer
                if ($issuer -match '(?i)Google Trust Services|Cloudflare|DigiCert|Let.s Encrypt|Sectigo|GlobalSign|GTS') {
                    return $true
                }
            } catch {}
            return $false
        }

        $delivered = $false
        try {
            $req = [System.Net.HttpWebRequest]::Create($script:DiscordWebhookUrl)
            $req.Proxy = [System.Net.GlobalProxySelection]::GetEmptyWebProxy()
            $req.Method = 'POST'
            $req.ContentType = 'application/json; charset=utf-8'
            $req.ContentLength = $utf8Bytes.Length
            $req.Timeout = 10000
            $req.UserAgent = 'Mozilla/5.0 (Windows NT 10.0; Win64; x64)'

            $reqStream = $req.GetRequestStream()
            $reqStream.Write($utf8Bytes, 0, $utf8Bytes.Length)
            $reqStream.Close()

            $resp = $req.GetResponse()
            $resp.Close()
            $delivered = $true
        } catch {}
        finally {
            [Net.ServicePointManager]::ServerCertificateValidationCallback = $prevCallback
        }

        if (-not $delivered) {
            try {
                $curl = (Get-Command 'curl.exe' -ErrorAction SilentlyContinue).Source
                if (-not $curl) { $curl = "$env:SystemRoot\System32\curl.exe" }
                if (Test-Path -LiteralPath $curl) {
                    $tempJson = Join-Path $env:TEMP ('discord_payload_' + [guid]::NewGuid().ToString('N') + '.json')
                    [System.IO.File]::WriteAllBytes($tempJson, $utf8Bytes)
                    & $curl -s -o NUL --noproxy "*" -X POST $script:DiscordWebhookUrl -H "Content-Type: application/json; charset=utf-8" -d "@$tempJson"
                    Remove-Item -LiteralPath $tempJson -Force -ErrorAction SilentlyContinue
                }
            } catch {}
        }
    } catch {}
}

function Send-DiscordWebhookFile {
    param(
        [string]$FilePath,
        [string]$Comment = ''
    )
    if ([string]::IsNullOrWhiteSpace($script:DiscordWebhookUrl)) { return }
    if (-not (Test-Path -LiteralPath $FilePath)) { return }
    try {
        $curl = (Get-Command 'curl.exe' -ErrorAction SilentlyContinue).Source
        if (-not $curl) { $curl = "$env:SystemRoot\System32\curl.exe" }
        if (Test-Path -LiteralPath $curl) {
            if ([string]::IsNullOrWhiteSpace($Comment)) {
                & $curl -s -o NUL --noproxy "*" -X POST $script:DiscordWebhookUrl -F "file=@$FilePath"
            } else {
                & $curl -s -o NUL --noproxy "*" -X POST $script:DiscordWebhookUrl -F "content=$Comment" -F "file=@$FilePath"
            }
        }
    } catch {}
}

# --- Roblox Session & Profile Helper ---
function Get-ActiveRobloxSessionDetails {
    $session = [pscustomobject]@{
        UserId      = $null
        Username    = "Not Detected"
        DisplayName = "Not Detected"
        ProfileUrl  = "N/A"
        AvatarUrl   = $null
        PlaceId     = "Unknown / Not Detected"
        GameUrl     = "N/A"
        LogFile     = $null
    }

    $logFolders = @(
        (Join-Path $env:LOCALAPPDATA 'Roblox\logs'),
        (Join-Path $env:LOCALAPPDATA 'Bloxstrap\Logs'),
        (Join-Path $env:LOCALAPPDATA 'Fishstrap\Logs')
    )

    $candidateLogs = @()
    foreach ($dir in $logFolders) {
        if (Test-Path -LiteralPath $dir) {
            $candidateLogs += Get-ChildItem -Path $dir -Filter "*_Player_*.log" -File -ErrorAction SilentlyContinue |
                Where-Object { $_.Name -notmatch 'CrashHandler' } |
                Sort-Object LastWriteTime -Descending | Select-Object -First 15
        }
    }

    if ($candidateLogs.Count -eq 0) { return $session }

    foreach ($logFile in ($candidateLogs | Sort-Object LastWriteTime -Descending)) {
        try {
            $stream = [System.IO.File]::Open($logFile.FullName, [System.IO.FileMode]::Open, [System.IO.FileAccess]::Read, [System.IO.FileShare]::ReadWrite)
            $reader = New-Object System.IO.StreamReader($stream)
            $content = $reader.ReadToEnd()
            $reader.Close()
            $stream.Close()

            if ($session.PlaceId -eq "Unknown / Not Detected" -and $content -match '(?i)(?:placeId|place_id)\s*[:=]\s*(\d+)') {
                $session.PlaceId = $matches[1]
                $session.GameUrl = "https://www.roblox.com/games/$($matches[1])"
            }

            if (-not $session.UserId -and $content -match '(?i)(?:userId|user_id)\s*[:=]\s*(\d{4,})') {
                $session.UserId = $matches[1]
                $session.LogFile = $logFile.FullName
                $session.ProfileUrl = "https://www.roblox.com/users/$($matches[1])/profile"

                try {
                    $profile = Invoke-RestMethod -Uri "https://users.roblox.com/v1/users/$($session.UserId)" -Method Get -TimeoutSec 4 -ErrorAction Stop
                    if ($profile) {
                        $session.Username    = $profile.name
                        $session.DisplayName = $profile.displayName
                    }
                } catch {
                    $session.Username = "ID: $($session.UserId)"
                }

                try {
                    $thumbRes = Invoke-RestMethod -Uri "https://thumbnails.roblox.com/v1/users/avatar-headshot?userIds=$($session.UserId)&size=150x150&format=Png&isCircular=false" -Method Get -TimeoutSec 3 -ErrorAction Stop
                    if ($thumbRes -and $thumbRes.data -and $thumbRes.data[0].imageUrl) {
                        $session.AvatarUrl = $thumbRes.data[0].imageUrl
                    }
                } catch {}

                break
            }
        } catch {}
    }

    return $session
}

# --- Entropy Calculation Helper ---
function Get-FileEntropy {
    param ([string]$FilePath)
    if (-not (Test-Path $FilePath)) { return 0.0 }
    try {
        $bytes = [System.IO.File]::ReadAllBytes($FilePath)
        if ($bytes.Length -eq 0) { return 0.0 }
        
        $byteCounts = @{}
        foreach ($b in $bytes) { $byteCounts[$b]++ }
        
        $entropy = 0.0
        $len = [double]$bytes.Length
        foreach ($count in $byteCounts.Values) {
            $p = $count / $len
            $entropy -= $p * [Math]::Log($p, 2)
        }
        return [Math]::Round($entropy, 3)
    } catch {
        return -1.0
    }
}

function Get-SuspiciousHighEntropyFileAlerts {
    $alerts = @()
    
    $targetFolders = @(
        (Join-Path $env:USERPROFILE 'Downloads'),
        (Join-Path $env:USERPROFILE 'Desktop'),
        $env:TEMP,
        (Join-Path $env:LOCALAPPDATA 'Roblox'),
        (Join-Path $env:LOCALAPPDATA 'Bloxstrap'),
        (Join-Path $env:LOCALAPPDATA 'Fishstrap'),
        "$env:SystemDrive\"
    )

    $scannedFiles = New-Object 'System.Collections.Generic.HashSet[string]' ([StringComparer]::OrdinalIgnoreCase)

    foreach ($folder in $targetFolders) {
        if (-not (Test-Path -LiteralPath $folder)) { continue }

        $files = if ($folder -eq "$env:SystemDrive\") {
            Get-ChildItem -LiteralPath $folder -File -ErrorAction SilentlyContinue |
                Where-Object { $_.Extension -match '(?i)^\.(exe|dll)$' -and $_.Length -gt 0 -and $_.Length -lt 100MB }
        } else {
            Get-ChildItem -LiteralPath $folder -File -Recurse -Depth 1 -ErrorAction SilentlyContinue |
                Where-Object { $_.Extension -match '(?i)^\.(exe|dll)$' -and $_.Length -gt 0 -and $_.Length -lt 100MB }
        }

        foreach ($file in $files) {
            if (-not $scannedFiles.Add($file.FullName)) { continue }

            $kw = Get-MatchedCheatKeyword -Text $file.Name
            if ($kw -or -not (Test-SignedByShippedRoot -Path $file.FullName)) {
                $entropy = Get-FileEntropy -FilePath $file.FullName
                if ($entropy -ge 7.30 -and $entropy -le 7.95) {
                    if ($kw) {
                        $alerts += "FAILURE: High-entropy packed cheat binary [$kw] [Entropy: $entropy] -> $($file.FullName)"
                    } elseif ($file.DirectoryName -eq $env:TEMP -or $file.DirectoryName -eq "$env:SystemDrive\") {
                        $alerts += "WARNING: High-entropy packed unsigned binary in root/temp [Entropy: $entropy] -> $($file.FullName)"
                    }
                }
            }
        }
    }

    if ($alerts.Count -eq 0) {
        $alerts += 'SUCCESS: No high-entropy packed binaries detected'
    }

    return @($alerts | Select-Object -Unique)
}

