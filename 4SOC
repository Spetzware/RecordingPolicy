                    }
                }
            }
        }
    }

    if (-not ($alerts | Where-Object { $_ -like 'FAILURE*' })) {
        $alerts = @('SUCCESS: Task Manager integrity intact; no suspicious modules detected') + $alerts
    }
    return @($alerts | Select-Object -Unique)
