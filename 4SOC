function Get-AlertSetSummary {
    param([string[]]$Lines)

    $s = @{ Fail = 0; Warn = 0; Info = 0; Pass = 0 }
    foreach ($line in @($Lines)) {
        if ($line -like 'FAILURE*')     { $s.Fail++ }
        elseif ($line -like 'WARNING*') { $s.Warn++ }
        elseif ($line -like 'INFO*')    { $s.Info++ }
        elseif ($line -like 'SUCCESS*') { $s.Pass++ }
    }
    if ($s.Fail -gt 0)     { $s.Status = 'FAIL' }
    elseif ($s.Warn -gt 0) { $s.Status = 'WARN' }
    elseif ($null -eq $Lines -or $Lines.Count -eq 0) { $s.Status = 'WARN'; $s.Warn = 1 }
    else                   { $s.Status = 'PASS' }
    return $s
}

function Test-AlertSetPassed {
    param([string[]]$Lines)
    return ((Get-AlertSetSummary -Lines $Lines).Status -ne 'FAIL')
}

function Get-TagColor {
    param([string]$Tag)
    switch ($Tag) {
        'PASS' { 'Green' }
        'FAIL' { 'Red' }
        'WARN' { 'Yellow' }
        'INFO' { 'DarkGray' }
        default { 'Gray' }
    }
}

function Write-TaggedLine {
    param([string]$Line, [string]$Indent = '  ')

    $tag = 'NOTE'; $text = $Line
    if ($Line -match '^(SUCCESS|FAILURE|WARNING|INFO):\s*(.*)$') {
        $text = $matches[2]
        switch ($matches[1]) {
            'SUCCESS' { $tag = 'PASS' }
            'FAILURE' { $tag = 'FAIL' }
            'WARNING' { $tag = 'WARN' }
            'INFO'    { $tag = 'INFO' }
        }
    }
    Write-Host "$Indent[" -NoNewline
    Write-Host $tag -ForegroundColor (Get-TagColor $tag) -NoNewline
    Write-Host "] " -NoNewline
    Write-Host $text -ForegroundColor $(if ($tag -eq 'INFO') { 'DarkGray' } else { 'Gray' })
}

function Write-Rule {
    param([int]$Width = 72, [string]$Color = 'DarkGray')
    Write-Host ('-' * $Width) -ForegroundColor $Color
}

function Write-Section {
    param($Title, $Lines)

    $summary = Get-AlertSetSummary -Lines @($Lines)
    Write-Host ''
    Write-Host '  ' -NoNewline
    Write-Host $Title -ForegroundColor Cyan -NoNewline
    Write-Host ' [' -NoNewline
    Write-Host $summary.Status -ForegroundColor (Get-TagColor $summary.Status) -NoNewline
    Write-Host ']'
    foreach ($line in @($Lines)) { Write-TaggedLine -Line $line -Indent '    ' }
}

