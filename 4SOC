function Get-RootCertificateAlerts {
    $alerts = @()
    $stores = @(
        @{ Path = 'Cert:\CurrentUser\Root';  Label = 'user' },
        @{ Path = 'Cert:\LocalMachine\Root'; Label = 'machine' }
    )
    foreach ($store in $stores) {
        $certs = @()
        try { $certs = @(Get-ChildItem -Path $store.Path -ErrorAction Stop) } catch { continue }
        foreach ($cert in $certs) {
            if (-not (Test-UserInstalledRootThumbprint -Thumbprint $cert.Thumbprint)) { continue }
            $subject = [string]$cert.Subject
            $short = $subject
            if ($subject -match 'CN=([^,]+)') { $short = $matches[1] }
            $when = Get-Date $cert.NotBefore -Format 'yyyy-MM-dd'
            $desc = "'$short' ($($store.Label) store, issued $when, $($cert.Thumbprint.Substring(0,8))...)"

            if ($subject -match '(?i)microsoft') {
                $alerts += "FAILURE: Forged Microsoft root certificate $desc"
            } elseif ($subject -match $script:WellKnownCaPattern) {
                $alerts += "INFO: Known vendor local root certificate $desc"
            } elseif ($store.Label -eq 'user') {
                $alerts += "WARNING: Root certificate installed in user store $desc"
            } else {
                $alerts += "WARNING: Unknown root certificate installed $desc"
            }
        }
    }
    if (-not ($alerts | Where-Object { $_ -like 'FAILURE*' -or $_ -like 'WARNING*' })) {
        $alerts = @('SUCCESS: No user-installed root certificates') + $alerts
    }
    return @($alerts | Select-Object -Unique)
}

function Get-RootCertificateThumbprintSet {
    $set = New-Object 'System.Collections.Generic.HashSet[string]' ([StringComparer]::OrdinalIgnoreCase)
    foreach ($p in @('Cert:\CurrentUser\Root', 'Cert:\LocalMachine\Root')) {
        try { Get-ChildItem -Path $p -ErrorAction Stop | ForEach-Object { [void]$set.Add("$p|$($_.Thumbprint)|$($_.Subject)") } } catch {}
    }
    return $set
}

function Get-RobloxModuleAlerts {
    $alerts = @()
    $procs = @()
    try { $procs = @(Get-Process -Name RobloxPlayerBeta -ErrorAction Stop) } catch {}
    if ($procs.Count -eq 0) { return @('INFO: Roblox is not running - loaded-module check skipped') }

    $seen = New-Object 'System.Collections.Generic.HashSet[string]' ([StringComparer]::OrdinalIgnoreCase)
    $checked = 0
    foreach ($proc in $procs) {
        $modules = $null
        try { $modules = $proc.Modules } catch {
            $alerts += "WARNING: Could not list modules of RobloxPlayerBeta (PID $($proc.Id)): $($_.Exception.Message)"
            continue
        }
        foreach ($m in $modules) {
            $file = [string]$m.FileName
            if (-not $file -or -not $seen.Add($file)) { continue }
            $lower = $file.ToLower()
            if ($lower.StartsWith("$($env:SystemRoot.ToLower())\")) { continue }
            $checked++

            $sig = $null
            try { $sig = Microsoft.PowerShell.Security\Get-AuthenticodeSignature -LiteralPath $file -ErrorAction Stop } catch {}
            $status = if ($sig) { [string]$sig.Status } else { 'Unknown' }
            $userLand = Test-UserLandProcessPath -ExecutablePath $file
            $kw = Get-MatchedCheatKeyword -Text $file
            $kwTag = if ($kw) { " [$kw]" } else { '' }

            if ($status -ne 'Valid') {
                $entropy = Get-FileEntropy -FilePath $file
                $alerts += "FAILURE: Unsigned/invalid module$kwTag loaded in Roblox ($status) [Entropy: $entropy] -> $file"
            } elseif (-not (Test-SignedByShippedRoot -Path $file)) {
                $alerts += "FAILURE: Module$kwTag signed by a user-installed root loaded in Roblox -> $file"
            } elseif ($userLand -and $kw) {
                $alerts += "FAILURE: Module [$kw] from a user folder loaded in Roblox -> $file"
            } elseif ($userLand) {
                $signer = ''
                if ($sig.SignerCertificate -and $sig.SignerCertificate.Subject -match 'CN=([^,]+)') { $signer = $matches[1] }
                $alerts += "WARNING: Signed module from a user folder loaded in Roblox ($signer) -> $file"
            }
        }
    }

    if ($alerts.Count -eq 0) { $alerts += "SUCCESS: All $checked non-Windows modules in Roblox are validly signed" }
    return @($alerts | Select-Object -Unique)
}

function Get-RobloxMemoryIntegrityAlerts {
    $alerts = @()
    if (-not (Initialize-ExternalScanApi)) {
        return @('WARNING: External scan API unavailable for memory integrity check')
    }

    $targets = @(Get-RobloxTargetIds)
    if ($targets.Count -eq 0) {
        return @('INFO: Roblox is not running - memory integrity scan skipped')
    }

    foreach ($targetPid in $targets) {
        # Check 1: Unbacked Executable Memory Pages
        $unbackedHits = $null
        try { $unbackedHits = [SocPolicy.ExternalScan]::FindUnbackedExecutablePages([int]$targetPid) } catch {}
        if ($unbackedHits) {
            foreach ($hit in $unbackedHits) {
                $parts = $hit -split '\|'
                $type = $parts[0]
                $base = if ($parts.Count -ge 2) { $parts[1] } else { '0x0' }
                $size = if ($parts.Count -ge 3) { $parts[2] } else { '0KB' }
                $prot = if ($parts.Count -ge 4) { $parts[3] } else { '' }
                $allocProt = if ($parts.Count -ge 5) { $parts[4] } else { '' }

                if ($type -eq 'HIDDEN_EXEC') {
                    $alerts += "FAILURE: Hidden executable memory detected in Roblox PID $($targetPid) (Base: $base, Size: $size) [Allocated as Executable ($allocProt), currently masked as $prot] -> Page Guard / Hook Hiding"
                } elseif ($type -eq 'RWX') {
                    $alerts += "FAILURE: Unbacked RWX memory detected in Roblox PID $($targetPid) (Base: $base, Size: $size) -> Injected shellcode / hook stub"
                } elseif ($type -eq 'MZ_PE') {
                    $alerts += "FAILURE: Injected manual-mapped PE module with unbacked MZ header in Roblox PID $($targetPid) (Base: $base, Size: $size)"
                } elseif ($type -like 'SIG_*') {
                    $sigName = $type.Substring(4)
                    $alerts += "FAILURE: Injected executor memory string detected [$sigName] in Roblox PID $($targetPid) (Base: $base, Size: $size)"
                } elseif ($type -eq 'UNBACKED_RX') {
                    $alerts += "FAILURE: Unbacked executable memory region in Roblox PID $($targetPid) (Base: $base, Size: $size) -> Injected code"
                }
            }
        }

        # Check 2: Unbacked Thread Start Addresses / Remote Threads
        $threadHits = $null
        try { $threadHits = [SocPolicy.ExternalScan]::FindUnbackedThreads([int]$targetPid) } catch {}
        if ($threadHits) {
            foreach ($hit in $threadHits) {
                $parts = $hit -split '\|', 4
                $tid = if ($parts.Count -ge 2) { $parts[1] } else { '0' }
                $addr = if ($parts.Count -ge 3) { $parts[2] } else { '0x0' }
                $prot = if ($parts.Count -ge 4) { $parts[3] } else { '' }
                $alerts += "FAILURE: Injected execution thread detected in Roblox PID $($targetPid) (Thread ID: $tid, StartAddress: $addr, Protect: $prot) -> Entry point outside loaded modules"
            }
        }

        # Check 3: DirectX Hook & SwapChain VTable Integrity
        $dxgiHits = $null
        try { $dxgiHits = [SocPolicy.ExternalScan]::CheckDirectXHooks([int]$targetPid) } catch {}
        if ($dxgiHits) {
            foreach ($hit in $dxgiHits) {
                $parts = $hit -split '\|'
                $hookType = $parts[0]

                if ($hookType -eq 'HOOK_PRESENT') {
                    $module = if ($parts.Count -ge 2) { $parts[1] } else { 'Unknown' }
                    $modulePath = if ($parts.Count -ge 3) { $parts[2] } else { '' }
                    $presentAddr = if ($parts.Count -ge 4) { $parts[3] } else { '' }
                    $targetAddr = if ($parts.Count -ge 5) { $parts[4] } else { '' }
                    $secTarget = if ($parts.Count -ge 6) { $parts[5] } else { '0x0' }
                    $secModule = if ($parts.Count -ge 7) { $parts[6] } else { 'NONE' }

                    $modLower = $module.ToLower()
                    $isKnownOverlay = ($modLower -in @('graphics-hook64.dll', 'discordhook64.dll', 'gameoverlayrenderer64.dll'))

                    if (-not $isKnownOverlay) {
                        $alerts += "FAILURE: Unauthorized DirectX Present detour hook in Roblox PID $targetPid -> Redirected to $targetAddr ($module) [Render Hook / ESP]"
                    } else {
                        # Strict validation of claimed overlay DLL
                        $sigValid = $false
                        $trustedSigner = $false
                        $signerName = 'Unknown'

                        if ($modulePath -and (Test-Path -LiteralPath $modulePath -PathType Leaf)) {
                            $sig = Get-AuthenticodeSignature -LiteralPath $modulePath -ErrorAction SilentlyContinue
                            if ($sig -and $sig.Status -eq 'Valid') {
                                $sigValid = $true
                                $signerName = if ($sig.SignerCertificate) { $sig.SignerCertificate.Subject } else { '' }
                                switch ($modLower) {
                                    'discordhook64.dll' {
                                        if ($signerName -match '(?i)Discord\s*Inc\.') { $trustedSigner = $true }
                                    }
                                    'graphics-hook64.dll' {
                                        if ($signerName -match '(?i)OBS\s*Project|Hugh\s*Bailey|Wizards\s*of\s*OBS') { $trustedSigner = $true }
                                    }
                                    'gameoverlayrenderer64.dll' {
                                        if ($signerName -match '(?i)Valve\s*Corp') { $trustedSigner = $true }
                                    }
                                }
                            }
                        }

                        # Path legitimacy check
                        $pathSuspicious = $false
                        $pathLower = $modulePath.ToLower()
                        if ($pathLower -match '(?i)\\temp\\|\\downloads\\|\\desktop\\|\\appdata\\local\\temp') {
                            $pathSuspicious = $true
                        }

                        if (-not $sigValid) {
                            $alerts += "FAILURE: Unsigned/invalid spoofed overlay DLL in Roblox PID $($targetPid): $module ($modulePath) -> Fake Overlay"
                        } elseif (-not $trustedSigner) {
                            $alerts += "FAILURE: Impersonated overlay DLL in Roblox PID $($targetPid): $module signed by untrusted entity ($signerName) -> Masqueraded Overlay"
                        } elseif ($pathSuspicious) {
                            $alerts += "FAILURE: Overlay DLL loaded from suspicious folder in Roblox PID $($targetPid): $module -> $modulePath"
                        } elseif ($secModule -ne 'NONE') {
                            $alerts += "FAILURE: In-memory overlay hijack in Roblox PID $($targetPid)! $module trampoline was patched to divert to $secTarget ($secModule) [Overlay Hijack Cheat]"
                        } else {
                            $alerts += "INFO: DirectX IDXGISwapChain::Present hooked by verified streaming software: $module (Signed by $signerName)"
                        }
                    }
                } elseif ($hookType -eq 'HOOK_EXPORT') {
                    $expFunc = if ($parts.Count -ge 2) { $parts[1] } else { '' }
                    $fnAddr = if ($parts.Count -ge 3) { $parts[2] } else { '' }
                    $alerts += "FAILURE: DirectX export detour hook detected on $expFunc in Roblox PID $targetPid (Address: $fnAddr) -> Render interceptor"
                }
            }
        }
    }

    # Also scan for known DirectX hook overlay DLLs loaded into Roblox
    $knownHookDlls = @('kiero', 'minhook', 'd3d11hook', 'dxgihook', 'imgui', 'imhook')
    try {
        foreach ($targetPid in $targets) {
            $proc = Get-Process -Id $targetPid -ErrorAction SilentlyContinue
            if ($proc) {
                foreach ($mod in $proc.Modules) {
                    $modNameLower = $mod.ModuleName.ToLower()
                    foreach ($kh in $knownHookDlls) {
                        if ($modNameLower -like "*$kh*") {
                            $alerts += "FAILURE: Known DirectX hooking DLL loaded in Roblox PID $targetPid -> $($mod.FileName)"
                        }
                    }
                }
            }
        }
    } catch {}

    if ($alerts.Count -eq 0) {
        $alerts += 'SUCCESS: Roblox memory integrity verified (No unbacked pages, unbacked threads, or DirectX hooks)'
    }

    return @($alerts | Select-Object -Unique)
}

function Get-AntiBypassAlerts {
    $alerts = @()

    # 1. Hosts File DNS Tampering / Webhook Sinkhole Check
    $hostsPath = "$env:SystemRoot\System32\drivers\etc\hosts"
    if (Test-Path -LiteralPath $hostsPath) {
        try {
            $hostsLines = Get-Content -LiteralPath $hostsPath -ErrorAction Stop
            $targetDomains = @('discord.com', 'discordapp.com', 'gateway.discord.gg', 'cdn.discordapp.com', 'discord.gg', 'roblox.com', 'setup.rbxcdn.com', 'clientsettings.roblox.com')
            $foundRedirects = @()
            foreach ($line in $hostsLines) {
                $trimmed = $line.Trim()
                if (-not $trimmed -or $trimmed.StartsWith('#')) { continue }
                foreach ($dom in $targetDomains) {
                    if ($trimmed -match "(?i)\b$([regex]::Escape($dom))\b") {
                        $foundRedirects += $trimmed
                        break
                    }
                }
            }
            if ($foundRedirects.Count -gt 0) {
                foreach ($r in $foundRedirects) {
                    $alerts += "FAILURE: Hosts file DNS tampering / webhook sinkhole: '$r' in $hostsPath"
                }
            } else {
                $alerts += "SUCCESS: Hosts file clean (No webhook or Roblox domain redirects)"
            }
        } catch {
            $alerts += "WARNING: Could not read hosts file: $($_.Exception.Message)"
        }
    } else {
        $alerts += "SUCCESS: Default hosts file configuration (No hosts file present)"
    }

    # 2. System Proxy & Network Evasion Check
    $proxySettings = Get-ItemProperty -Path 'HKCU:\Software\Microsoft\Windows\CurrentVersion\Internet Settings' -ErrorAction SilentlyContinue
    $proxyActive = $false
    if ($proxySettings) {
        if ($proxySettings.ProxyEnable -eq 1 -and $proxySettings.ProxyServer) {
            $proxyActive = $true
            $alerts += "FAILURE: Active system proxy configured: $($proxySettings.ProxyServer) (ProxyEnable=1) -> Audit traffic diversion"
        }
        if ($proxySettings.AutoConfigURL) {
            $proxyActive = $true
            $alerts += "FAILURE: Automatic proxy configuration (PAC) script configured: $($proxySettings.AutoConfigURL)"
        }
    }
    foreach ($envVar in @('HTTP_PROXY', 'HTTPS_PROXY', 'ALL_PROXY', 'http_proxy', 'https_proxy', 'all_proxy')) {
        $val = [Environment]::GetEnvironmentVariable($envVar, 'Process')
        if (-not $val) { $val = [Environment]::GetEnvironmentVariable($envVar, 'User') }
        if (-not $val) { $val = [Environment]::GetEnvironmentVariable($envVar, 'Machine') }
        if ($val) {
            $proxyActive = $true
            $alerts += "FAILURE: Environment proxy variable active: $envVar = $val"
        }
    }
    if (-not $proxyActive) {
        $alerts += "SUCCESS: System proxy disabled (Direct connection)"
    }

    # 3. Network Interceptor / Debugger Tool Process Check
    $interceptorNames = @(
        'fiddler', 'charles', 'mitmproxy', 'mitmdump', 'httpdebuggerui', 'httpdebuggersvc',
        'proxifier', 'reqable', 'wireshark', 'burpsuite', 'burpsuitecommunity', 'burpsuitepro', 'zap'
    )
    $runningInterceptors = @()
    foreach ($proc in (Get-Process -ErrorAction SilentlyContinue)) {
        $pNameLower = $proc.ProcessName.ToLower()
        if ($interceptorNames -contains $pNameLower) {
            $runningInterceptors += "$($proc.ProcessName) (PID $($proc.Id))"
        }
    }
    if ($runningInterceptors.Count -gt 0) {
        foreach ($tool in $runningInterceptors) {
            $alerts += "FAILURE: Network interceptor / traffic debugger active: $tool -> Network evasion tool"
        }
    } else {
        $alerts += "SUCCESS: No network interception or proxy debuggers running"
    }

    # 4. Webhook & DNS Endpoint Reachability Check
    try {
        $resolvedIps = [System.Net.Dns]::GetHostAddresses('discord.com')
        $loopbackFound = $false
        foreach ($ip in $resolvedIps) {
            $ipStr = $ip.IPAddressToString
            if ($ipStr.StartsWith('127.') -or $ipStr -eq '0.0.0.0' -or $ipStr -eq '::1') {
                $loopbackFound = $true
                $alerts += "FAILURE: DNS spoofing detected for discord.com -> Resolves to local loopback address ($ipStr)"
            }
        }
        if (-not $loopbackFound) {
            $alerts += "SUCCESS: Webhook DNS resolution verified ($($resolvedIps.Count) public endpoint(s))"
        }
    } catch {
        $alerts += "WARNING: DNS resolution check for discord.com failed: $($_.Exception.Message)"
    }

    # 5. Recent Log-Wiping & Recycle Bin Audit
    $logFolders = @(
        (Join-Path $env:LOCALAPPDATA 'Roblox\logs'),
        (Join-Path $env:LOCALAPPDATA 'Bloxstrap\Logs'),
        (Join-Path $env:LOCALAPPDATA 'Fishstrap\Logs')
    )
    $hasExistingFolder = $false
    $totalLogs = 0
    foreach ($lf in $logFolders) {
        if (Test-Path -LiteralPath $lf) {
            $hasExistingFolder = $true
            $logs = Get-ChildItem -LiteralPath $lf -Filter "*_Player_*.log" -File -ErrorAction SilentlyContinue
            if ($logs) { $totalLogs += $logs.Count }
        }
    }
    $bamRobloxRan = $false
    try {
        $bamRobloxRan = [bool](Get-BamEntries | Where-Object { $_.Leaf -match '(?i)^RobloxPlayerBeta\.exe$' -and $_.Time -ge (Get-Date).Date })
    } catch {}
    if ($hasExistingFolder -and $totalLogs -eq 0 -and $bamRobloxRan) {
        $alerts += "FAILURE: Roblox executed today but 0 player logs exist in log directory -> Logs were wiped"
    }

    try {
        $shell = New-Object -ComObject Shell.Application
        $bin = $shell.Namespace(0xA)
        if ($bin) {
            $binHits = @()
            foreach ($item in $bin.Items()) {
                $name = $item.Name
                if ($name -match '(?i)\.(lua|luau|dmp)$' -or $name -match '(?i)_Player_.*\.log$' -or (Get-MatchedCheatKeyword -Text $name)) {
                    $binHits += $name
                }
            }
            if ($binHits.Count -gt 0) {
                foreach ($bh in ($binHits | Select-Object -First 3)) {
                    $alerts += "WARNING: Deleted cheat/log artifact found in Recycle Bin: '$bh'"
                }
            }
        }
    } catch {}

    # 6. Active Remote Debugger Check on PowerShell
    if ('SocPolicy.IntegrityScan' -as [type]) {
        try {
            if ([SocPolicy.IntegrityScan]::IsPowerShellDebugged()) {
                $alerts += "FAILURE: Active debugger attached to powershell.exe (Script manipulation / breakpoint attempt)"
            }
        } catch {}
    }

    # 7. PowerShell Profile Tampering Check
    $profilePaths = @(
        $PROFILE.CurrentUserCurrentHost,
        $PROFILE.CurrentUserAllHosts,
        $PROFILE.AllUsersCurrentHost,
        $PROFILE.AllUsersAllHosts
    ) | Where-Object { $_ -and (Test-Path -LiteralPath $_ -PathType Leaf) }

    foreach ($prof in $profilePaths) {
        try {
            $txt = [System.IO.File]::ReadAllText($prof)
            $kw = Get-MatchedCheatKeyword -Text $txt
            if ($kw -or $txt -match '(?i)function\s+(Get-Process|Get-Item|Add-Type|Invoke-RestMethod|Get-CimInstance)') {
                $alerts += "FAILURE: Tampered PowerShell profile script: $prof (Contains cmdlet hooks / [$kw])"
            } else {
                $alerts += "INFO: PowerShell profile present: $prof ($((Get-Item -LiteralPath $prof).Length) bytes)"
            }
        } catch {}
    }

    # 8. Network Interface Loopback DNS Check
    try {
        $dnsServers = Get-DnsClientServerAddress -AddressFamily IPv4 -ErrorAction SilentlyContinue
        foreach ($ds in $dnsServers) {
            foreach ($addr in $ds.ServerAddresses) {
                if ($addr.StartsWith('127.') -or $addr -eq '0.0.0.0' -or $addr -eq '::1') {
                    $alerts += "FAILURE: Loopback DNS sinkhole configured on adapter '$($ds.InterfaceAlias)': $addr"
                }
            }
        }
    } catch {}

    # 9. In-Memory PowerShell Syscall Integrity Check (Prevents hook hiding and API subversion)
    foreach ($line in (Get-NtdllSyscallIntegrityAlerts)) {
        if ($line -like 'FAILURE*' -or $line -like 'WARNING*') {
            $alerts += $line
        }
    }

    return @($alerts | Select-Object -Unique)
}

