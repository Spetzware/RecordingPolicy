            $name = [string]$vc.Name
            $desc = [string]$vc.Description
            $driver = [string]$vc.InstalledDisplayDrivers
            $fullInfo = "$name $desc $driver"

            if ($fullInfo -match $virtualPatterns) {
                $alerts += "FAILURE: Virtual display adapter detected: $name [$($matches[1])]"
            }
        }

        $pnpDevices = @(Get-CimInstance Win32_PnPEntity -ErrorAction SilentlyContinue |
            Where-Object { $_.PNPClass -in @('Display', 'Monitor') })
        foreach ($dev in $pnpDevices) {
            $devName = [string]$dev.Name
            $devId = [string]$dev.DeviceID
            if ("$devName $devId" -match $virtualPatterns) {
                $alerts += "FAILURE: Virtual monitor / display PnP device detected: $devName [$($matches[1])]"
            }
        }

        try {
            Add-Type -AssemblyName System.Windows.Forms -ErrorAction SilentlyContinue
            $screens = [System.Windows.Forms.Screen]::AllScreens
            if ($screens -and $screens.Count -gt 0) {
                $alerts += "INFO: Display configuration: $($screens.Count) active screen(s)"
                $sIdx = 1
                foreach ($s in $screens) {
                    $alerts += "INFO: Screen $sIdx : $($s.DeviceName) ($($s.Bounds.Width)x$($s.Bounds.Height), Primary: $($s.Primary))"
                    $sIdx++
                }
            }
        } catch {}

        if ($alerts.Count -eq 0 -or ($alerts | Where-Object { $_ -like 'FAILURE*' }).Count -eq 0) {
            $alerts = @("SUCCESS: Display configuration verified (No virtual/dummy display drivers detected)") + $alerts
        }
    } catch {
        $alerts += "WARNING: Exception scanning display adapters: $($_.Exception.Message)"
    }

    return $alerts
}

function Get-HiddenDesktopAlerts {
    $alerts = @()
    if (-not (Initialize-SocPolicyAntiTamperApi)) {
        return @('WARNING: Could not initialize AntiTamper native API for desktop audit')
    }

    try {
        $desktops = [SocPolicy.AntiTamperScan]::GetDesktopList()
        if ($null -eq $desktops -or $desktops.Length -eq 0) {
            return @('SUCCESS: Window station desktops verified (Standard desktop session)')
        }

        $suspiciousDesktops = @()
        foreach ($d in $desktops) {
            if ([string]::IsNullOrWhiteSpace($d)) { continue }
            if ($d -match '(?i)^(Default|Winlogon|Disconnect|Screen-saver)$' -or $d -match '(?i)^exebox-') {
                continue
            }
            $suspiciousDesktops += $d
        }

        if ($suspiciousDesktops.Count -gt 0) {
            foreach ($sd in $suspiciousDesktops) {
                $alerts += "FAILURE: Suspicious hidden desktop detected on window station: '$sd' (Possible screen bypass)"
            }
        } else {
            $alerts += "SUCCESS: Window station desktops verified (No hidden desktop sessions detected)"
        }
    } catch {
        $alerts += "WARNING: Exception during desktop enumeration: $($_.Exception.Message)"
    }

    return $alerts
}

