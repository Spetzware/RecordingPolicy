function Write-MonitorAlert {
    param(
        [string]$Message,
        [string]$LogFile,
        [string]$Color = '',
        [ValidateSet('', 'FAIL', 'WARN', 'INFO', 'NOTE')]
        [string]$Level = ''
    )

    $text = $Message
    if ($Message -match '^(SUCCESS|FAILURE|WARNING|INFO):\s*(.*)$') {
        $text = $matches[2]
        if (-not $Level) {
            switch ($matches[1]) {
                'FAILURE' { $Level = 'FAIL' }
                'WARNING' { $Level = 'WARN' }
                'INFO'    { $Level = 'INFO' }
                'SUCCESS' { $Level = 'INFO' }
            }
        }
    }
    if (-not $Level) { $Level = if ($Color -eq 'Yellow') { 'WARN' } else { 'NOTE' } }
    $tagColor = switch ($Level) { 'FAIL' { 'Red' } 'WARN' { 'Yellow' } 'INFO' { 'DarkGray' } default { 'Cyan' } }
    if ($script:MonitorAlertCounts.ContainsKey($Level)) { $script:MonitorAlertCounts[$Level]++ }

    $timestamp = Get-Date -Format "yyyy-MM-dd HH:mm:ss"
    Clear-MonitorStatusLine
    Write-Host "  [$(Get-Date -Format 'HH:mm:ss')] " -NoNewline -ForegroundColor DarkGray
    Write-Host "[$Level]" -NoNewline -ForegroundColor $tagColor
    Write-Host " $text" -ForegroundColor $(if ($Level -eq 'FAIL') { 'Red' } elseif ($Level -eq 'INFO') { 'DarkGray' } else { 'Gray' })
    Invoke-ConsoleRefresh
    try {
        Add-Content -LiteralPath $LogFile -Value "[$timestamp] [$Level] $text" -ErrorAction Stop
    } catch {
        $fallback = Join-Path $env:TEMP '4soc_events.log'
        try { Add-Content -LiteralPath $fallback -Value "[$timestamp] [$Level] $text" -ErrorAction SilentlyContinue } catch {}
    }

    if ($Level -in @('FAIL', 'WARN')) {
        if (-not $script:RbxSession.UserId) {
            $script:RbxSession = Get-ActiveRobloxSessionDetails
        }
        $playerDesc = if ($script:RbxSession.ProfileUrl -and $script:RbxSession.ProfileUrl -ne "N/A") {
            "**Roblox User:** [$($script:RbxSession.Username)]($($script:RbxSession.ProfileUrl)) (ID: $($script:RbxSession.UserId))`n**PC:** $($env:USERNAME) on $($env:COMPUTERNAME)"
        } else {
            "**Player:** $($script:RbxSession.Username)`n**PC:** $($env:USERNAME) on $($env:COMPUTERNAME)"
        }
        $colorInt = if ($Level -eq 'FAIL') { 15158332 } else { 15844367 }
        $liveEmbedObj = @{
            title       = "Live Monitor Event: [$Level]"
            description = $playerDesc
            color       = $colorInt
            fields      = @(
                @{
                    name   = "Alert"
                    value  = $text
                    inline = $false
                }
            )
            timestamp   = (Get-Date).ToUniversalTime().ToString("yyyy-MM-ddTHH:mm:ssZ")
        }
        if ($script:RbxSession.AvatarUrl) {
            $liveEmbedObj['thumbnail'] = @{ url = $script:RbxSession.AvatarUrl }
        }
        Send-DiscordWebhookPayload -Payload @{ embeds = @($liveEmbedObj) }
    }
}

