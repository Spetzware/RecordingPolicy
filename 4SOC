function Get-PowerShellSelfIntegrityAlerts {
    $alerts = @()
    try {
        $currentProc = [System.Diagnostics.Process]::GetCurrentProcess()
        $suspiciousModules = @()

        foreach ($mod in $currentProc.Modules) {
            $modPath = $mod.FileName
            if ([string]::IsNullOrWhiteSpace($modPath)) { continue }

            $isWhitelisted = $false
            if ($modPath -like "$env:SystemRoot\System32\*" -or
                $modPath -like "$env:SystemRoot\SysWOW64\*" -or
                $modPath -like "$env:SystemRoot\WinSxS\*" -or
                $modPath -like "$env:ProgramFiles\*" -or
                $modPath -like "${env:ProgramFiles(x86)}\*" -or
                $modPath -like "$env:SystemRoot\Microsoft.NET\*" -or
                $modPath -like "$env:ProgramData\Microsoft\Windows Defender\Platform\*" -or
                $modPath -like "$env:SystemRoot\assembly\*") {
                $isWhitelisted = $true
            }

            if (-not $isWhitelisted) {
                if (Test-SignedByShippedRoot -Path $modPath) {
                    $isWhitelisted = $true
                } else {
                    $suspiciousModules += "$($mod.ModuleName) ($modPath)"
                }
            }
        }

        if ($suspiciousModules.Count -gt 0) {
            foreach ($sm in $suspiciousModules) {
                $alerts += "FAILURE: Untrusted/injected module loaded in PowerShell process: $sm"
            }
        } else {
            $alerts += "SUCCESS: PowerShell process modules verified ($($currentProc.Modules.Count) modules, 0 untrusted)"
        }
    } catch {
        $alerts += "WARNING: Exception checking PowerShell process modules: $($_.Exception.Message)"
    }

    return $alerts
}

