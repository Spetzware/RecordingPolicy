    $batch = @($allEmbeds[$i..($end - 1)])
    Send-DiscordWebhookPayload -Payload @{ embeds = $batch }
}

# 6. Dispatch complete 1:1 Plain-Text Audit Log as a file attachment
if (Test-Path -LiteralPath $tempAuditLog) {
    Send-DiscordWebhookFile -FilePath $tempAuditLog -Comment "**[1:1 Audit Log]** Complete unclipped console output for **$($script:RbxSession.Username)** on **$($env:COMPUTERNAME)**"
    Remove-Item -LiteralPath $tempAuditLog -Force -ErrorAction SilentlyContinue
}

Write-Host "  Press Enter to continue to Step 2..." -ForegroundColor Yellow
Read-Host | Out-Null

Write-StepHeader 'Step 2 of 3  -  Process Explorer'
